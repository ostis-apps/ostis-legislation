			<- concept_answer;;
		*);
		ll_d1_v2_a4 (*
			=> nrel_content: [применяется Конституция Республики Беларусь] (* <- lang_ru;; *);;
			<- concept_answer;;
		*);;
		
		
		
		
		
		
ll_d1_v3
	=> nrel_content: [Локальные  правовые акты:] (* <- lang_ru;; *);
