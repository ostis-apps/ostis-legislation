			<- concept_answers;;
		*);
		ll_d2_v4_a4 (*
			=> nrel_content: [гражданин Республики Беларусь имеет право отказаться от выполнения порученной работы (оказания услуги) после уведомления уполномоченного должностного лица нанимателя в течение одного часа, для иностранных граждан и лиц без гражданства установлен иной порядок] (* <- lang_ru;; *);;
			<- concept_answers;;
			*);;





