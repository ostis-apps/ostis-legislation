	=> nrel_answers:
		ll_d2_v4_a1 (*
			=> nrel_content: [работник имеет право на отказ от выполнения порученной работы] (* <- lang_ru;; *);;
			<- concept_answers;;
			<- concept_correct_answer;;
		*);
		ll_d2_v4_a2 (*
			=> nrel_content: [работник не имеет права отказаться от выполнения порученной работы (оказания услуги)] (* <- lang_ru;; *);;
			<- concept_answers;;
		*);
		ll_d2_v4_a3 (*
