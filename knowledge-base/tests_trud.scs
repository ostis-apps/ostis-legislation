concept_difficulty
	=> nrel_main_idtf: [Сложность] (* <- lang_ru;; *); [Difficulty] (* <- lang_en;; *);
	-> concept_begginer;
	-> concept_intermediate;
	-> concept_advanced;;
	

concept_tests => nrel_main_idtf: [Тесты] (* <- lang_ru;; *); [Tests] (* <- lang_en;; *);;
concept_correct_answer => nrel_main_idtf: [Правильный ответ] (* <- lang_ru;; *); [Correct answer] (* <- lang_en;; *);;	


concept_labor_law
	=> nrel_main_idtf: [Трудовое право] (* <- lang_ru;; *); [Labor law] (* <- lang_en;; *);
	<- concept_test;
	
	-> cl_d1 (*
		<- sc_node_tuple;;
		<- concept_begginer;;
		-> ll_d1_v1;;
		-> ll_d1_v2;;
		-> ll_d1_v3;;
		-> ll_d1_v4;;
		-> ll_d1_v5;;
		-> ll_d1_v6;;
		-> ll_d1_v7;;
		-> ll_d1_v8;;
		-> ll_d1_v9;;
		-> ll_d1_v10;;
	*);;
	
	
ll_d1_v1
	=> nrel_content: [Трудовой кодекс Республики Беларусь применяется в отношении:] (* <- lang_ru;; *);
	<- concept_question;
	
	=> nrel_answer:
		ll_d1_v1_a1 (*
			=> nrel_content: [всех работающих и работодателей ] (* <- lang_ru;; *);;
			<- concept_answer;;
			<- concept_correct_answer;;
		*);
		ll_d1_v1_a2 (*
			=> nrel_content: [работников и нанимателей–организаций любых организационно-правовых форм] (* <- lang_ru;; *);;
			<- concept_answer;;
		*);
		ll_d1_v1_a3 (*
			=> nrel_content: [работников и нанимателей–государственных организаций] (* <- lang_ru;; *);;
			<- concept_answer;;
		*);
		ll_d1_v1_a4 (*
			=> nrel_content: [всех работников и нанимателей] (* <- lang_ru;; *);;
			<- concept_answer;;
		*);;
		
	
	
	
	
	
	
	
	
	
