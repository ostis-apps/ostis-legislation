	ll_d1_v6
	=> nrel_content: [Установленный по общему правилу возраст наступления трудовой правосубъектности гражданина:] (* <- lang_ru;; *);
	<- concept_question;
	
	=> nrel_answer:
		ll_d1_v6_a1 (*
			=> nrel_content: [может быть снижен с письменного согласия одного из родителей (усыновителя, попечителя), для выполнения лёгкого труда, не причиняющего вреда здоровью и не нарушающего процесса обучения] (* <- lang_ru;; *);;
			<- concept_answer;;
			<- concept_correct_answer;;
		*);
		ll_d1_v6_a2 (*
			=> nrel_content: [может быть снижен с письменного согласия обоих родителей (усыновителей, попечителей), для выполнения лёгкого труда, не причиняющего вреда здоровью и не нарушающего процесса обучения] (* <- lang_ru;; *);;
			<- concept_answer;;
		*);
		ll_d1_v6_a3 (*
			=> nrel_content: [может быть снижен по решению органов опеки и попечительства, для выполнения труда, не причиняющего вреда здоровью и не нарушающего процесса обучения] (* <- lang_ru;; *);;
			<- concept_answer;;
		*);
		ll_d1_v6_a4 (*
			=> nrel_content: [не может быть снижен, потому что трудовая правосубъектность возникает с рождения] (* <- lang_ru;; *);;
			<- concept_answer;;
		*);;
		



