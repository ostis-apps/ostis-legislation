	=> nrel_answer:
		ll_d1_v3_a1 (*
			=> nrel_content: [содержащие условия, ухудшающие положение работников по сравнению с законодательством о труде, являются недействительными] (* <- lang_ru;; *);;
			<- concept_answer;;
