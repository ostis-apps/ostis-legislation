		ll_d1_v3_a2 (*
			=> nrel_content: [содержащие условия, ухудшающие положение работников по сравнению с законодательством о труде, являются действительными] (* <- lang_ru;; *);;
			<- concept_answer;;
		*);
		ll_d1_v3_a3 (*
			=> nrel_content: [содержащие условия, улучшающие положение работников по сравнению с законодательством о труде, являются недействительными] (* <- lang_ru;; *);;
