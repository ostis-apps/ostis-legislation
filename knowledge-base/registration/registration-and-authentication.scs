registered_jurisprudence_user
    => nrel_main_idtf: [пользователь, зарегистрированный в системе по юриспруденции] (* <- lang_ru;; *);
    => nrel_main_idtf: [user registered in the system for jurisprudence] (* <- lang_en;; *);
    => nrel_main_idtf: [карыстальнік, зарэгістраваны ў сістэме па юрыспрудэнцыі] (* <- lang_by;; *);
    <- sc_node_class;;

