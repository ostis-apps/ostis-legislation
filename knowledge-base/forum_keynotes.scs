// Форум - основные концепты

concept_topic <- sc_node_class;
=> nrel_main_idtf:
    [топик*]
    (* <- lang_ru;; *);
    [topic*]
    (* <- lang_en;; *);;

concept_message <- sc_node_class;
=> nrel_main_idtf:
    [сообщение*]
    (* <- lang_ru;; *);
    [message*]
    (* <- lang_en;; *);;

nrel_topic_title <- sc_node_norole_relation;
=> nrel_main_idtf:
    [заголовок топика*]
    (* <- lang_ru;; *);
    [topic title*]
    (* <- lang_en;; *);;

nrel_topic_description <- sc_node_norole_relation;
=> nrel_main_idtf:
    [описание топика*]
    (* <- lang_ru;; *);
