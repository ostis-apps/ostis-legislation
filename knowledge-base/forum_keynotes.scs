=> nrel_main_idtf:
    [автор сообщения*]
    (* <- lang_ru;; *);
    [message author*]
    (* <- lang_en;; *);;

action_add_topic <- sc_node_class;
=> nrel_main_idtf:
    [действие. добавить топик]
    (* <- lang_ru;; *);
    [action. add topic]
    (* <- lang_en;; *);;

